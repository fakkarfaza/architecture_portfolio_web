{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter Web - Dev",
            "request": "launch",
            "type": "dart",
            "deviceId": "edge",
            "args": [
                "--web-port=51093",
                "--dart-define=ENV=dev",
                "--dart-define=API_BASE_URL=http://localhost:8080"
            ]
        },
        {
            "name": "Flutter Web - Prod",
            "request": "launch",
            "type": "dart",
            "deviceId": "edge",
            "args": [
                "--dart-define=ENV=prod",
                "--dart-define=API_BASE_URL=https://your-production-api.com"
            ]
        }
    ]
}